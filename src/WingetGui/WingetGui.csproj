<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WingetGui</RootNamespace>
    <AssemblyName>WingetGui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged and self-contained, like MarkItDown-GUI: runs from a plain folder. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.9</Version>
    <Product>Winget GUI</Product>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- The UI is English only; skips .NET's translated resource folders (176 files). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Program.cs supplies Main: command-line switches run without a window, and the app stays single-instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <!-- Their C# wrappers, unused (the native side is excluded by ExcludeUnusedWindowsAppSDKFiles below). Versions are the
         ones the metapackage pins; update together. The metapackage stays: H.NotifyIcon.WinUI depends on it. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.53" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2141" ExcludeAssets="all" />
    <!-- Also referenced by Core, but needed here too: the package copies its native activation dll from build/ targets,
         which only run in projects that reference it directly. Without it: REGDB_E_CLASSNOTREG at new PackageManager(). -->
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" />
    <!-- WinUI 3 has no notification-area icon API. -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WingetGui.Core\WingetGui.Core.csproj" />
  </ItemGroup>

  <!--
    Self-contained mode copies everything in the Windows App Runtime MSIX next to the exe, including Windows AI/ML
    (ONNX Runtime and DirectML alone are ~38 MB), Widgets, and WinUI's built-in text in ~90 languages. None of that is
    used, so leave it out through the SDK's own exclusion list. Runs after the MSIX is unpacked so the wildcards match.
    If a Windows App SDK update renames these files they simply come back; nothing breaks.
  -->
  <Target Name="ExcludeUnusedWindowsAppSDKFiles"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix"
          DependsOnTargets="ExtractMicrosoftWindowsAppSDKMsixFiles">
    <ItemGroup>
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\onnxruntime*.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\DirectML.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.AI.*.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.Workloads*.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\workloads*.json" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\NpuDetect\**" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.Widgets.dll" />
      <!-- The UI is English only; other languages fall back to English. -->
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\**\*.mui"
                                           Exclude="$(MicrosoftWindowsAppSDKMsixContent)\en-*\*.mui" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window, tray and notification icon; build-icon.ps1 regenerates it. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="Assets\build-icon.ps1;Assets\icon-preview.png" />
    <None Include="Assets\build-icon.ps1;Assets\icon-preview.png" />
  </ItemGroup>

</Project>
