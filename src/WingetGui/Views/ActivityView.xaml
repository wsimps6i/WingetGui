<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WingetGui.Views.ActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:WingetGui.Core"
    xmlns:local="using:WingetGui.Views">

    <Grid Padding="24,4,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Activity" />
            <Button HorizontalAlignment="Right" Click="ClearFinished_Click" Content="Clear finished" />
        </Grid>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Installs, updates and uninstalls you start show up here, one at a time." />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind Queue.Operations}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:QueuedOperation">
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind local:ActivityView.StatusText(Status, Stage), Mode=OneWay}" />
                            <ProgressBar
                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                Visibility="{x:Bind IsActive, Mode=OneWay}"
                                Value="{x:Bind ProgressValue, Mode=OneWay}" />
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Click="Cancel_Click"
                            Content="Cancel"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsActive, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
