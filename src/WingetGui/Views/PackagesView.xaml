<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WingetGui.Views.PackagesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:WingetGui.Core"
    xmlns:local="using:WingetGui.Views">

    <Grid Padding="24,4,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Filter panel, between the menu and the list. Changes apply straight away. -->
        <ScrollViewer
            x:Name="FilterPanel"
            Grid.RowSpan="4"
            Width="230"
            Margin="0,8,16,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <Expander AutomationProperties.Name="Sources" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                            <TextBlock Text="Sources" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <StackPanel Margin="-12,0,0,4" Orientation="Horizontal">
                            <HyperlinkButton Click="SelectAllSources_Click" Content="Select all" />
                            <HyperlinkButton Click="ClearSources_Click" Content="Clear selection" />
                        </StackPanel>
                        <StackPanel x:Name="SourceChecks" />
                    </StackPanel>
                </Expander>

                <Expander
                    x:Name="FiltersExpander"
                    AutomationProperties.Name="Filters"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE71C;" />
                            <TextBlock Text="Filters" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Show only packages that:"
                            TextWrapping="Wrap" />
                        <CheckBox x:Name="HasUpdateCheck" Click="Filter_Click" Content="Have an update" />
                        <CheckBox x:Name="PinnedCheck" Click="Filter_Click" Content="Are pinned" />
                        <CheckBox x:Name="ReinstallCheck" Click="Filter_Click" Content="Need a reinstall to update" />
                    </StackPanel>
                </Expander>

                <Expander
                    x:Name="SearchModeExpander"
                    AutomationProperties.Name="Search mode"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE721;" />
                            <TextBlock Text="Search mode" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <!-- Items are in SearchField order. -->
                        <RadioButtons
                            x:Name="FieldButtons"
                            AutomationProperties.Name="Match"
                            SelectedIndex="2"
                            SelectionChanged="SearchMode_Changed">
                            <x:String>Package name</x:String>
                            <x:String>Package ID</x:String>
                            <x:String>Both</x:String>
                        </RadioButtons>
                        <CheckBox x:Name="ExactCheck" Click="SearchMode_Changed" Content="Exact match" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Bottom"
                Margin="0,0,0,5"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="480" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" TextChanged="QueryBox_TextChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ToggleButton
                    x:Name="FilterToggle"
                    AutomationProperties.Name="Show filters"
                    Click="FilterToggle_Click"
                    IsChecked="True"
                    ToolTipService.ToolTip="Show or hide filters">
                    <FontIcon FontSize="16" Glyph="&#xE71C;" />
                </ToggleButton>
                <Button x:Name="InstallSelectedButton" Click="InstallSelected_Click" Content="Install selected" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="UpdateSelectedButton" Click="UpdateSelected_Click" Content="Update selected" />
                <Button x:Name="UpdateAllButton" Click="UpdateAll_Click" Content="Update all" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="UninstallSelectedButton" Click="UninstallSelected_Click" Content="Uninstall selected" />
                <Button x:Name="MoreButton" AutomationProperties.Name="More" ToolTipService.ToolTip="Export or import a package list">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="Export_Click" Text="Export package list…" />
                            <MenuFlyoutItem Click="Import_Click" Text="Import package list…" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="RefreshButton" AutomationProperties.Name="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="1">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="Status" IsClosable="True" />
        </StackPanel>

        <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,0,12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource NameColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource IdColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource VersionColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource VersionColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource SourceColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Name" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="Id" />
                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="Installed" />
                    <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Text="Available" />
                    <TextBlock Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" Text="Source" />
                </Grid>
                <ListView
                    x:Name="List"
                    Grid.Row="1"
                    SelectionChanged="List_SelectionChanged"
                    SelectionMode="Extended">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:PackageItem">
                            <Grid Height="36" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource NameColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource IdColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource VersionColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource VersionColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource SourceColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Id}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind InstalledVersion}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Opacity="{x:Bind local:PackagesView.DimIf(IsUpdateNotApplicable)}"
                                    Text="{x:Bind AvailableText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind local:PackagesView.AvailableTip(IsUpdateNotApplicable)}" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Source}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        x:Name="DetailsPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Select a package to see its details."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ScrollViewer x:Name="Details" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailId" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="DetailPublisher" TextWrapping="Wrap" />

                            <StackPanel x:Name="InstallPanel" Spacing="8">
                                <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch" Header="Version" />
                                <Button Click="InstallOne_Click" Content="Install" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="InstalledPanel" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="UpdateOneButton" Click="UpdateOne_Click" Content="Update" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Click="UninstallOne_Click" Content="Uninstall" />
                                    <Button x:Name="PinButton" Click="Pin_Click" Content="Pin" />
                                </StackPanel>
                                <Button
                                    x:Name="SkipButton"
                                    Click="Skip_Click"
                                    ToolTipService.ToolTip="Hide this version from updates. A newer version shows up again." />
                            </StackPanel>

                            <!-- Saved per package: used for every install and update of it (scope for installs only). -->
                            <Expander
                                x:Name="OptionsExpander"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Install options"
                                Header="Install options">
                                <StackPanel Spacing="8">
                                    <ComboBox x:Name="ScopeBox" HorizontalAlignment="Stretch" Header="Scope (new installs)">
                                        <x:String>Default</x:String>
                                        <x:String>Current user</x:String>
                                        <x:String>All users (machine)</x:String>
                                    </ComboBox>
                                    <!-- Items are in InstallArchitecture order. -->
                                    <ComboBox x:Name="ArchBox" HorizontalAlignment="Stretch" Header="Architecture">
                                        <x:String>Default</x:String>
                                        <x:String>x64</x:String>
                                        <x:String>x86</x:String>
                                        <x:String>Arm64</x:String>
                                    </ComboBox>
                                    <TextBox
                                        x:Name="ArgsBox"
                                        Header="Extra installer arguments"
                                        PlaceholderText="Added to the silent switches" />
                                    <TextBlock
                                        x:Name="OptionsNote"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="SaveOptions_Click" Content="Remember for this package" />
                                        <Button x:Name="ForgetOptionsButton" Click="ForgetOptions_Click" Content="Forget" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <StackPanel x:Name="InstallerPanel" Spacing="2">
                                <TextBlock x:Name="DetailInstaller" TextWrapping="Wrap" />
                                <HyperlinkButton x:Name="DetailDownload" Padding="0" />
                                <TextBlock
                                    x:Name="DetailSha"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock x:Name="DetailDescription" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="DetailHomepage" Padding="0" Content="Homepage" />
                            <TextBlock x:Name="DetailLicense" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailNotesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Release notes" />
                            <TextBlock x:Name="DetailNotes" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
