<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WingetGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="24,4,24,16" HorizontalAlignment="Left" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <RadioButtons x:Name="ThemeButtons" Header="Theme" SelectionChanged="Theme_SelectionChanged">
                <x:String>Use system setting</x:String>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
            </RadioButtons>

            <ToggleSwitch
                x:Name="CloseToTraySwitch"
                Header="Closing the window keeps Winget GUI running in the notification area"
                Toggled="CloseToTray_Toggled" />

            <ToggleSwitch
                x:Name="StartupSwitch"
                Header="Start at sign-in, hidden in the notification area"
                Toggled="Startup_Toggled" />

            <ComboBox
                x:Name="CheckIntervalBox"
                Width="260"
                Header="Check for updates in the background"
                SelectionChanged="Check_SelectionChanged">
                <x:String>Off</x:String>
                <x:String>Every hour</x:String>
                <x:String>Every 3 hours</x:String>
                <x:String>Every 6 hours</x:String>
                <x:String>Every 12 hours</x:String>
                <x:String>Every 24 hours</x:String>
            </ComboBox>

            <ComboBox
                x:Name="ScopeBox"
                Width="260"
                Header="Default install scope"
                SelectionChanged="Scope_SelectionChanged">
                <x:String>Default (installer decides)</x:String>
                <x:String>Current user</x:String>
                <x:String>All users (machine)</x:String>
            </ComboBox>

            <NumberBox
                x:Name="RetentionBox"
                Width="200"
                HorizontalAlignment="Left"
                Header="Keep log files for (days)"
                Maximum="365"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="Retention_ValueChanged" />

            <Button Click="OpenLogs_Click" Content="Open log folder" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="About Winget GUI" />
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ToggleSwitch
                x:Name="AppUpdateSwitch"
                Header="Check for new versions of Winget GUI automatically"
                Toggled="AppUpdate_Toggled" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckAppButton" Click="CheckApp_Click" Content="Check for updates" />
                <Button
                    x:Name="InstallAppButton"
                    Click="InstallApp_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed" />
                <HyperlinkButton x:Name="ReleaseLink" Content="What's new" Visibility="Collapsed" />
            </StackPanel>
            <ProgressBar
                x:Name="AppUpdateProgress"
                Width="320"
                HorizontalAlignment="Left"
                Maximum="100"
                Visibility="Collapsed" />
            <TextBlock x:Name="AppUpdateStatus" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
