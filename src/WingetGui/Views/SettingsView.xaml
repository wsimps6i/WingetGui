<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WingetGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- One card per setting, in the style of the Windows Settings app (same as MarkItDown GUI). -->
        <Style x:Key="SettingsCardStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>
        <Style
            x:Key="SettingsSectionStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,12,0,4" />
        </Style>
        <Style
            x:Key="SettingsDescriptionStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- Changes apply and are saved straight away. -->
    <ScrollViewer>
        <StackPanel Padding="24,4,24,16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <Grid MaxWidth="1200" HorizontalAlignment="Stretch" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Appearance" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE790;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="App theme" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Light, dark, or the same as Windows." />
                        </StackPanel>
                        <!-- Items are in AppTheme order. -->
                        <ComboBox
                            x:Name="ThemeBox"
                            Grid.Column="2"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="App theme"
                            SelectionChanged="Theme_SelectionChanged">
                            <x:String>Use system setting</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Window" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE921;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Close to the notification area" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Closing the window keeps Winget GUI running, so it can keep checking for updates." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CloseToTraySwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="Close to the notification area"
                            Toggled="CloseToTray_Toggled" />
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE7E8;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start at sign-in" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Start hidden in the notification area when you sign in to Windows." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartupSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="Start at sign-in"
                            Toggled="Startup_Toggled" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Packages" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE895;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Check for updates in the background" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Shows a notification when new package updates are found." />
                        </StackPanel>
                        <ComboBox
                            x:Name="CheckIntervalBox"
                            Grid.Column="2"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Check for updates in the background"
                            SelectionChanged="Check_SelectionChanged">
                            <x:String>Off</x:String>
                            <x:String>Every hour</x:String>
                            <x:String>Every 3 hours</x:String>
                            <x:String>Every 6 hours</x:String>
                            <x:String>Every 12 hours</x:String>
                            <x:String>Every 24 hours</x:String>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE77B;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Default install scope" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Who new installs are for, unless you pick otherwise when installing." />
                        </StackPanel>
                        <ComboBox
                            x:Name="ScopeBox"
                            Grid.Column="2"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Default install scope"
                            SelectionChanged="Scope_SelectionChanged">
                            <x:String>Default (installer decides)</x:String>
                            <x:String>Current user</x:String>
                            <x:String>All users (machine)</x:String>
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Logs" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE81C;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Keep log files for (days)" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="One log file per day; older ones are deleted." />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <NumberBox
                                x:Name="RetentionBox"
                                AutomationProperties.Name="Keep log files for (days)"
                                Maximum="365"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="Retention_ValueChanged" />
                            <Button Click="OpenLogs_Click" Content="Open folder" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="About" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="20"
                            Height="20"
                            VerticalAlignment="Top"
                            Margin="0,4,0,0"
                            Source="ms-appx:///Assets/AppIcon.ico" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Winget GUI" />
                            <TextBlock
                                x:Name="VersionText"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource SettingsDescriptionStyle}" />
                            <TextBlock
                                x:Name="AppUpdateStatus"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource SettingsDescriptionStyle}" />
                            <ProgressBar
                                x:Name="AppUpdateProgress"
                                Margin="0,4,0,0"
                                Maximum="100"
                                Visibility="Collapsed" />
                            <HyperlinkButton
                                x:Name="ReleaseLink"
                                Padding="0,2"
                                Content="What's new"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button x:Name="CheckAppButton" Click="CheckApp_Click" Content="Check for updates" />
                            <Button
                                x:Name="InstallAppButton"
                                Click="InstallApp_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE896;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Check for new versions automatically" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Looks for new Winget GUI releases on GitHub and offers to install them." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="AppUpdateSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="Check for new versions of Winget GUI automatically"
                            Toggled="AppUpdate_Toggled" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
