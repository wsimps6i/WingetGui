<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows TFM + RID: the ComInterop package copies a native Microsoft.Management.Deployment.dll (see PLANNING.md, Phase 0). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WingetGui.Core.Tests" />
  </ItemGroup>

</Project>
